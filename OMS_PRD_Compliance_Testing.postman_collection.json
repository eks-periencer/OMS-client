                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Welcome email sent successfully\",\n  \"metadata\": {\n    \"emailTemplate\": \"welcome_email\",\n    \"sentAt\": \"2025-01-09T10:00:00Z\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/onboarding/{{onboardingId}}/step/welcome_sent/complete",
              "host": ["{{baseUrl}}"],
              "path": ["onboarding", "{{onboardingId}}", "step", "welcome_sent", "complete"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Welcome email step completed', () => {",
