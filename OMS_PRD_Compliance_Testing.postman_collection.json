    {
      "name": "6. Verification & Testing",
      "item": [
        {
          "name": "Get Workflow State",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/onboarding/{{onboardingId}}/workflow/state",
              "host": ["{{baseUrl}}"],
              "path": ["onboarding", "{{onboardingId}}", "workflow", "state"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Workflow state retrieved', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.data.current).to.eql('completed');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Workflow History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/onboarding/{{onboardingId}}/workflow/history",
              "host": ["{{baseUrl}}"],
              "path": ["onboarding", "{{onboardingId}}", "workflow", "history"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Workflow history retrieved', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.history).to.be.an('array');",
                  "    pm.expect(response.history.length).to.be.greaterThan(0);",
